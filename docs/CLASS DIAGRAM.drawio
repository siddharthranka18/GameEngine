        <UserObject label="Generalization&#xa;────────▷&#xa;Subclass inherits from superclass&#xa;IS-A relationship" mermaidId="n:L5" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#E8DAEF;strokeColor=#7D3C98;fontColor=#512E5F;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Generalization&#xa;────────▷&#xa;Subclass inherits from superclass&#xa;IS-A relationship" id="vnEgjqSYXmxVSSmhWQC2-811">
          <mxCell parent="vnEgjqSYXmxVSSmhWQC2-806" style="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#E8DAEF;strokeColor=#7D3C98;fontColor=#512E5F;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
