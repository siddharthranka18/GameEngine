        <UserObject label="Usage Dependency&#xa;- - - - → «use»&#xa;One class uses another class service" mermaidId="n:L8" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#D6EAF8;strokeColor=#3498DB;fontColor=#154360;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Usage Dependency&#xa;- - - - → «use»&#xa;One class uses another class service" id="vnEgjqSYXmxVSSmhWQC2-814">
          <mxCell parent="vnEgjqSYXmxVSSmhWQC2-806" style="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#D6EAF8;strokeColor=#3498DB;fontColor=#154360;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="93" width="317" x="41" y="1103" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\nclass EpsteinEngine {\n    -Project project\n    -SceneManager sceneManager\n    -AssetManager assetManager\n    -Renderer renderer\n    -PhysicsEngine physicsEngine\n    -InputManager inputManager\n    -GameRuntime runtime\n    -Profiler profiler\n    -BuildSystem buildSystem\n    -AudioSystem audioSystem\n    +initialize() void\n    +update() void\n    +render() void\n    +shutdown() void\n}\n\nclass Project {\n    -String name\n    -String path\n    -List~Scene~ scenes\n    -Scene startupScene\n    +create() void\n    +open() void\n    +save() void\n    +close() void\n}\n\nclass SceneManager {\n    -Scene activeScene\n    +createScene() Scene\n    +loadScene(String id) Scene\n    +saveScene(Scene scene) void\n    +deleteScene(String id) void\n    +addObject(GameObject object) void\n    +removeObject(String id) void\n}\n\nclass Scene {\n    -String id\n    -String name\n    -List~GameObject~ objects\n    -List~Light~ lights\n    -List~Camera~ cameras\n    -Camera activeCamera\n    +addObject(GameObject object) void\n    +removeObject(String id) void\n    +addLight(Light light) void\n    +addCamera(Camera camera) void\n    +update() void\n}\n\nclass GameObject {\n    -String id\n    -String name\n    -Transform transform\n    -Mesh mesh\n    -Material material\n    -RigidBody rigidBody\n    -Collider collider\n    +setPosition(Vector3 position) void\n    +setRotation(Vector3 rotation) void\n    +setScale(Vector3 scale) void\n    +update() void\n}\n\nclass Transform {\n    -Vector3 position\n    -Vector3 rotation\n    -Vector3 scale\n    +translate(Vector3 offset) void\n    +rotate(Vector3 rotation) void\n    +setScale(Vector3 scale) void\n}\n\nclass AssetManager {\n    -List~Asset~ assets\n    +importAsset(String path) Asset\n    +removeAsset(String id) void\n    +findAsset(String id) Asset\n    +validateAsset(Asset asset) bool\n    +generateLOD(Asset asset) void\n    +generateCollisionData(Asset asset) void\n}\n\nclass Asset {\n    &lt;&lt;abstract&gt;&gt;\n    #String id\n    #String name\n    #String filePath\n    +load() void\n    +unload() void\n}\n\nclass Mesh {\n    -Vertex[] vertices\n    -Index[] indices\n    +loadMesh() void\n    +unloadMesh() void\n}\n\nclass Texture {\n    -int width\n    -int height\n    -String format\n    +loadTexture() void\n    +unloadTexture() void\n}\n\nclass Material {\n    -Vector3 baseColor\n    -float metallic\n    -float roughness\n    -Texture albedo\n    -Texture normalMap\n    -Texture roughnessMap\n    +setBaseColor(Vector3 color) void\n    +setMetallic(float value) void\n    +setRoughness(float value) void\n    +apply() void\n}\n\nclass Renderer {\n    +initialize() void\n    +renderScene(Scene scene) void\n    +processGeometry() void\n    +applyMaterials() void\n    +calculateLighting() void\n    +renderShadows() void\n    +renderFrame() void\n}\n\nclass Camera {\n    -Vector3 position\n    -Vector3 rotation\n    -float fieldOfView\n    -float nearClip\n    -float farClip\n    +setPosition(Vector3 position) void\n    +setRotation(Vector3 rotation) void\n    +setFOV(float fov) void\n    +calculateViewMatrix() Matrix\n    +calculateProjectionMatrix() Matrix\n}\n\nclass LightingSystem {\n    -List~Light~ lights\n    +addLight(Light light) void\n    +removeLight(Light light) void\n    +updateLighting() void\n    +calculateShadows() void\n}\n\nclass Light {\n    &lt;&lt;abstract&gt;&gt;\n    #Vector3 position\n    #Vector3 color\n    #float intensity\n    +setIntensity(float value) void\n    +setColor(Vector3 color) void\n}\n\nclass DirectionalLight {\n    -Vector3 direction\n    +setDirection(Vector3 direction) void\n}\n\nclass PointLight {\n    -float range\n    +setRange(float range) void\n}\n\nclass SpotLight {\n    -Vector3 direction\n    -float range\n    -float coneAngle\n    +setDirection(Vector3 direction) void\n    +setRange(float range) void\n    +setConeAngle(float angle) void\n}\n\nclass PhysicsEngine {\n    -Vector3 gravity\n    +initialize() void\n    +simulate(float deltaTime) void\n    +detectCollisions() void\n    +resolveCollisions() void\n    +applyForces() void\n}\n\nclass Collider {\n    &lt;&lt;abstract&gt;&gt;\n    +checkCollision(Collider other) bool\n    +getBounds() Bounds\n}\n\nclass RigidBody {\n    -float mass\n    -Vector3 velocity\n    -Vector3 acceleration\n    +applyForce(Vector3 force) void\n    +applyImpulse(Vector3 impulse) void\n    +update(float deltaTime) void\n}\n\nclass InputManager {\n    -List~InputAction~ actions\n    +processKeyboard() void\n    +processMouse() void\n    +processController() void\n    +isKeyPressed(String key) bool\n    +isMouseButtonPressed(int button) bool\n}\n\nclass InputAction {\n    -String name\n    -String keyBinding\n    +isTriggered() bool\n}\n\nclass GameRuntime {\n    -bool running\n    -float deltaTime\n    +start() void\n    +gameLoop() void\n    +update() void\n    +stop() void\n}\n\nclass AudioSystem {\n    -float masterVolume\n    +initialize() void\n    +loadSound(String path) void\n    +playSound(String id) void\n    +stopSound(String id) void\n    +setVolume(float volume) void\n}\n\nclass AudioSource {\n    -String audioFile\n    -float volume\n    -bool looping\n    +play() void\n    +pause() void\n    +stop() void\n}\n\nclass Profiler {\n    +startFrame() void\n    +endFrame() void\n    +measureCPU() float\n    +measureGPU() float\n    +measureMemory() float\n    +getFPS() float\n    +generateReport() String\n}\n\nclass BuildSystem {\n    -String targetPlatform\n    -String outputPath\n    +configureBuild() void\n    +collectAssets() void\n    +packageAssets() void\n    +compileGame() void\n    +buildGame() void\n    +deployGame() void\n}\n\n\n%% =========================\n%% ASSOCIATIONS\n%% =========================\n\nEpsteinEngine --&gt; Project : manages\nEpsteinEngine --&gt; SceneManager : uses\nEpsteinEngine --&gt; AssetManager : uses\nEpsteinEngine --&gt; Renderer : uses\nEpsteinEngine --&gt; PhysicsEngine : uses\nEpsteinEngine --&gt; InputManager : uses\nEpsteinEngine --&gt; GameRuntime : controls\nEpsteinEngine --&gt; Profiler : uses\nEpsteinEngine --&gt; BuildSystem : uses\nEpsteinEngine --&gt; AudioSystem : uses\n\nProject *-- Scene : contains\nProject --&gt; Scene : startup\n\nSceneManager --&gt; Scene : manages\n\nScene *-- GameObject : contains\nScene o-- Light : contains\nScene o-- Camera : contains\n\nGameObject *-- Transform : owns\nGameObject o-- Mesh : references\nGameObject o-- Material : references\nGameObject o-- RigidBody : references\nGameObject o-- Collider : references\n\nAssetManager o-- Asset : manages\n\nAsset &lt;|-- Mesh\nAsset &lt;|-- Texture\nAsset &lt;|-- Material\n\nMaterial --&gt; Texture : uses\n\nRenderer --&gt; Scene : renders\nRenderer --&gt; Camera : uses\nRenderer --&gt; LightingSystem : uses\n\nLightingSystem o-- Light : manages\n\nLight &lt;|-- DirectionalLight\nLight &lt;|-- PointLight\nLight &lt;|-- SpotLight\n\nPhysicsEngine --&gt; GameObject : updates\nPhysicsEngine o-- Collider : manages\nPhysicsEngine o-- RigidBody : manages\n\nInputManager o-- InputAction : manages\n\nGameRuntime --&gt; SceneManager : loads\nGameRuntime --&gt; InputManager : processes\nGameRuntime --&gt; PhysicsEngine : runs\nGameRuntime --&gt; Renderer : renders\nGameRuntime --&gt; AudioSystem : controls\nGameRuntime --&gt; Profiler : records\n\nAudioSystem o-- AudioSource : manages\n\nBuildSystem --&gt; Project : builds\nBuildSystem --&gt; AssetManager : collects\n\n\n%% =========================\n%% DOTTED DEPENDENCIES\n%% =========================\n\nRenderer ..&gt; Material : depends on\nRenderer ..&gt; Mesh : depends on\nBuildSystem ..&gt; AssetManager : depends on\nProfiler ..&gt; GameRuntime : monitors\n\n\n%% =========================\n%% DIRECT CLASS COLORS\n%% =========================\n\nstyle EpsteinEngine fill:#BBDEFB,stroke:#0D47A1,stroke-width:3px\nstyle Project fill:#BBDEFB,stroke:#0D47A1,stroke-width:3px\n\nstyle SceneManager fill:#C8E6C9,stroke:#1B5E20,stroke-width:3px\nstyle Scene fill:#C8E6C9,stroke:#1B5E20,stroke-width:3px\nstyle GameObject fill:#C8E6C9,stroke:#1B5E20,stroke-width:3px\nstyle Transform fill:#C8E6C9,stroke:#1B5E20,stroke-width:3px\nstyle Camera fill:#C8E6C9,stroke:#1B5E20,stroke-width:3px\n\nstyle AssetManager fill:#FFE0B2,stroke:#E65100,stroke-width:3px\nstyle Asset fill:#FFE0B2,stroke:#E65100,stroke-width:3px\nstyle Mesh fill:#FFE0B2,stroke:#E65100,stroke-width:3px\nstyle Texture fill:#FFE0B2,stroke:#E65100,stroke-width:3px\nstyle Material fill:#FFE0B2,stroke:#E65100,stroke-width:3px\n\nstyle Renderer fill:#E1BEE7,stroke:#4A148C,stroke-width:3px\nstyle LightingSystem fill:#E1BEE7,stroke:#4A148C,stroke-width:3px\nstyle Light fill:#E1BEE7,stroke:#4A148C,stroke-width:3px\nstyle DirectionalLight fill:#E1BEE7,stroke:#4A148C,stroke-width:3px\nstyle PointLight fill:#E1BEE7,stroke:#4A148C,stroke-width:3px\nstyle SpotLight fill:#E1BEE7,stroke:#4A148C,stroke-width:3px\n\nstyle PhysicsEngine fill:#F8BBD0,stroke:#880E4F,stroke-width:3px\nstyle Collider fill:#F8BBD0,stroke:#880E4F,stroke-width:3px\nstyle RigidBody fill:#F8BBD0,stroke:#880E4F,stroke-width:3px\n\nstyle InputManager fill:#B2EBF2,stroke:#006064,stroke-width:3px\nstyle InputAction fill:#B2EBF2,stroke:#006064,stroke-width:3px\n\nstyle GameRuntime fill:#FFF9C4,stroke:#F57F17,stroke-width:3px\nstyle Profiler fill:#FFF9C4,stroke:#F57F17,stroke-width:3px\n\nstyle AudioSystem fill:#D1C4E9,stroke:#311B92,stroke-width:3px\nstyle AudioSource fill:#D1C4E9,stroke:#311B92,stroke-width:3px\n\nstyle BuildSystem fill:#D7CCC8,stroke:#3E2723,stroke-width:3px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6PAY1TXzUWEajJNPX8O_-583">
