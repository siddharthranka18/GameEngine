        <UserObject label="Realization&#xa;- - - -▷&#xa;Class implements an interface" mermaidId="n:L6" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#D1F2EB;strokeColor=#148F77;fontColor=#0B5345;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Realization&#xa;- - - -▷&#xa;Class implements an interface" id="vnEgjqSYXmxVSSmhWQC2-812">
          <mxCell parent="vnEgjqSYXmxVSSmhWQC2-806" style="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#D1F2EB;strokeColor=#148F77;fontColor=#0B5345;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="93" width="277" x="61" y="817" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Dependency&#xa;- - - - →&#xa;One class depends on another" mermaidId="n:L7" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#E5E7E9;strokeColor=#566573;fontColor=#273746;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Dependency&#xa;- - - - →&#xa;One class depends on another" id="vnEgjqSYXmxVSSmhWQC2-813">
          <mxCell parent="vnEgjqSYXmxVSSmhWQC2-806" style="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#E5E7E9;strokeColor=#566573;fontColor=#273746;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
