<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="_BR685GYbXJFT7yjo6pC">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" background="light-dark(#FFFFFF,#000000)" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\n    %% ========================================\n    %% CORE ENGINE\n    %% ========================================\n\n    class EpsteinEngine {\n        -Project project\n        -SceneManager sceneManager\n        -AssetManager assetManager\n        -Renderer renderer\n        -PhysicsEngine physicsEngine\n        -InputManager inputManager\n        -GameRuntime runtime\n        -Profiler profiler\n        -BuildSystem buildSystem\n        +initialize()\n        +update()\n        +render()\n        +shutdown()\n    }\n\n    class Project {\n        -String name\n        -String path\n        -List~Scene~ scenes\n        -Scene startupScene\n        +create()\n        +open()\n        +save()\n        +close()\n    }\n\n\n    %% ========================================\n    %% SCENE MANAGEMENT\n    %% ========================================\n\n    class SceneManager {\n        -Scene activeScene\n        +createScene()\n        +loadScene()\n        +saveScene()\n        +deleteScene()\n        +addObject()\n        +removeObject()\n    }\n\n    class Scene {\n        -String id\n        -String name\n        -List~GameObject~ objects\n        -List~Light~ lights\n        -List~Camera~ cameras\n        -Camera activeCamera\n        +addObject()\n        +removeObject()\n        +addLight()\n        +addCamera()\n        +update()\n    }\n\n    class GameObject {\n        -String id\n        -String name\n        -Transform transform\n        -Mesh mesh\n        -Material material\n        -RigidBody rigidBody\n        -Collider collider\n        +setPosition()\n        +setRotation()\n        +setScale()\n        +update()\n    }\n\n    class Transform {\n        -Vector3 position\n        -Vector3 rotation\n        -Vector3 scale\n        +translate()\n        +rotate()\n        +scale()\n    }\n\n\n    %% ========================================\n    %% ASSET MANAGEMENT\n    %% ========================================\n\n    class AssetManager {\n        -List~Asset~ assets\n        +importAsset()\n        +removeAsset()\n        +findAsset()\n        +validateAsset()\n        +generateLOD()\n        +generateCollisionData()\n    }\n\n    class Asset {\n        &lt;&lt;abstract&gt;&gt;\n        -String id\n        -String name\n        -String filePath\n        +load()\n        +unload()\n    }\n\n    class Mesh {\n        -Vertex[] vertices\n        -Index[] indices\n        +loadMesh()\n        +unloadMesh()\n    }\n\n    class Texture {\n        -int width\n        -int height\n        -String format\n        +loadTexture()\n        +unloadTexture()\n    }\n\n    class Material {\n        -Vector3 baseColor\n        -float metallic\n        -float roughness\n        -Texture albedo\n        -Texture normalMap\n        -Texture roughnessMap\n        +setBaseColor()\n        +setMetallic()\n        +setRoughness()\n        +apply()\n    }\n\n\n    %% ========================================\n    %% RENDERING\n    %% ========================================\n\n    class Renderer {\n        +initialize()\n        +renderScene()\n        +processGeometry()\n        +applyMaterials()\n        +calculateLighting()\n        +renderShadows()\n        +renderFrame()\n    }\n\n    class Camera {\n        -Vector3 position\n        -Vector3 rotation\n        -float fieldOfView\n        -float nearClip\n        -float farClip\n        +setPosition()\n        +setRotation()\n        +setFOV()\n        +calculateViewMatrix()\n        +calculateProjectionMatrix()\n    }\n\n\n    %% ========================================\n    %% LIGHTING\n    %% ========================================\n\n    class LightingSystem {\n        -List~Light~ lights\n        +addLight()\n        +removeLight()\n        +updateLighting()\n        +calculateShadows()\n    }\n\n    class Light {\n        &lt;&lt;abstract&gt;&gt;\n        -Vector3 position\n        -Vector3 color\n        -float intensity\n        +setIntensity()\n        +setColor()\n    }\n\n    class DirectionalLight {\n        -Vector3 direction\n        +setDirection()\n    }\n\n    class PointLight {\n        -float range\n        +setRange()\n    }\n\n    class SpotLight {\n        -Vector3 direction\n        -float range\n        -float coneAngle\n        +setDirection()\n        +setRange()\n        +setConeAngle()\n    }\n\n\n    %% ========================================\n    %% PHYSICS\n    %% ========================================\n\n    class PhysicsEngine {\n        -Vector3 gravity\n        +initialize()\n        +simulate()\n        +detectCollisions()\n        +resolveCollisions()\n        +applyForces()\n    }\n\n    class Collider {\n        &lt;&lt;abstract&gt;&gt;\n        +checkCollision()\n        +getBounds()\n    }\n\n    class RigidBody {\n        -float mass\n        -Vector3 velocity\n        -Vector3 acceleration\n        +applyForce()\n        +applyImpulse()\n        +update()\n    }\n\n\n    %% ========================================\n    %% INPUT\n    %% ========================================\n\n    class InputManager {\n        -Map~InputAction~ actions\n        +processKeyboard()\n        +processMouse()\n        +processController()\n        +isKeyPressed()\n        +isMouseButtonPressed()\n        +getControllerInput()\n    }\n\n    class InputAction {\n        -String name\n        -String keyBinding\n        +isTriggered()\n    }\n\n\n    %% ========================================\n    %% GAME RUNTIME\n    %% ========================================\n\n    class GameRuntime {\n        -bool running\n        -float deltaTime\n        +start()\n        +gameLoop()\n        +update()\n        +stop()\n    }\n\n\n    %% ========================================\n    %% AUDIO\n    %% ========================================\n\n    class AudioSystem {\n        -float masterVolume\n        +initialize()\n        +loadSound()\n        +playSound()\n        +stopSound()\n        +setVolume()\n    }\n\n    class AudioSource {\n        -String audioFile\n        -float volume\n        -bool looping\n        +play()\n        +pause()\n        +stop()\n    }\n\n\n    %% ========================================\n    %% PROFILING\n    %% ========================================\n\n    class Profiler {\n        +startFrame()\n        +endFrame()\n        +measureCPU()\n        +measureGPU()\n        +measureMemory()\n        +getFPS()\n        +generateReport()\n    }\n\n\n    %% ========================================\n    %% BUILD SYSTEM\n    %% ========================================\n\n    class BuildSystem {\n        -String targetPlatform\n        -String outputPath\n        +configureBuild()\n        +collectAssets()\n        +packageAssets()\n        +compileGame()\n        +buildGame()\n        +deployGame()\n    }\n\n\n    %% ========================================\n    %% CORE RELATIONSHIPS\n    %% ========================================\n\n    EpsteinEngine *-- Project\n    EpsteinEngine *-- SceneManager\n    EpsteinEngine *-- AssetManager\n    EpsteinEngine *-- Renderer\n    EpsteinEngine *-- PhysicsEngine\n    EpsteinEngine *-- InputManager\n    EpsteinEngine *-- GameRuntime\n    EpsteinEngine *-- Profiler\n    EpsteinEngine *-- BuildSystem\n    EpsteinEngine *-- AudioSystem\n\n    Project *-- Scene\n    Project --&gt; Scene : startup scene\n\n    SceneManager --&gt; Scene : manages\n\n    Scene *-- GameObject\n    Scene *-- Light\n    Scene *-- Camera\n\n    GameObject *-- Transform\n    GameObject --&gt; Mesh\n    GameObject --&gt; Material\n    GameObject --&gt; RigidBody\n    GameObject --&gt; Collider\n\n\n    %% ========================================\n    %% ASSET RELATIONSHIPS\n    %% ========================================\n\n    AssetManager o-- Asset : manages\n\n    Asset &lt;|-- Mesh\n    Asset &lt;|-- Texture\n    Asset &lt;|-- Material\n\n    Material --&gt; Texture : uses\n\n\n    %% ========================================\n    %% RENDERING RELATIONSHIPS\n    %% ========================================\n\n    Renderer --&gt; Scene : renders\n    Renderer --&gt; Camera : uses\n    Renderer --&gt; LightingSystem : uses\n    Renderer --&gt; Material : uses\n    Renderer --&gt; Mesh : renders\n\n\n    %% ========================================\n    %% LIGHTING RELATIONSHIPS\n    %% ========================================\n\n    LightingSystem o-- Light : manages\n\n    Light &lt;|-- DirectionalLight\n    Light &lt;|-- PointLight\n    Light &lt;|-- SpotLight\n\n\n    %% ========================================\n    %% PHYSICS RELATIONSHIPS\n    %% ========================================\n\n    PhysicsEngine --&gt; GameObject : updates\n    PhysicsEngine o-- Collider : manages\n    PhysicsEngine o-- RigidBody : manages\n\n\n    %% ========================================\n    %% INPUT RELATIONSHIPS\n    %% ========================================\n\n    InputManager o-- InputAction : manages\n\n\n    %% ========================================\n    %% RUNTIME RELATIONSHIPS\n    %% ========================================\n\n    GameRuntime --&gt; SceneManager : loads scenes\n    GameRuntime --&gt; InputManager : processes input\n    GameRuntime --&gt; PhysicsEngine : runs physics\n    GameRuntime --&gt; Renderer : renders\n    GameRuntime --&gt; AudioSystem : controls audio\n    GameRuntime --&gt; Profiler : reports metrics\n\n\n    %% ========================================\n    %% AUDIO RELATIONSHIPS\n    %% ========================================\n\n    AudioSystem o-- AudioSource : manages\n\n\n    %% ========================================\n    %% BUILD RELATIONSHIPS\n    %% ========================================\n\n    BuildSystem --&gt; Project : builds\n    BuildSystem --&gt; AssetManager : collects assets&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="x-bveDUuiPJZzHSNuPIv-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
