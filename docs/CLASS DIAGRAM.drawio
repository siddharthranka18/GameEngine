        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% =========================================================\n%% EPSTEIN ENGINE\n%% =========================================================\n\nEE[\&quot;&lt;b&gt;EpsteinEngine&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- Project project&lt;br/&gt;- SceneManager sceneManager&lt;br/&gt;- AssetManager assetManager&lt;br/&gt;- Renderer renderer&lt;br/&gt;- PhysicsEngine physicsEngine&lt;br/&gt;- InputManager inputManager&lt;br/&gt;- GameRuntime runtime&lt;br/&gt;- Profiler profiler&lt;br/&gt;- BuildSystem buildSystem&lt;br/&gt;&lt;hr/&gt;+ initialize()&lt;br/&gt;+ update()&lt;br/&gt;+ render()&lt;br/&gt;+ shutdown()\&quot;]\n\nP[\&quot;&lt;b&gt;Project&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- name : String&lt;br/&gt;- path : String&lt;br/&gt;- startupScene : String&lt;br/&gt;&lt;hr/&gt;+ create()&lt;br/&gt;+ open()&lt;br/&gt;+ save()&lt;br/&gt;+ close()\&quot;]\n\nSM[\&quot;&lt;b&gt;SceneManager&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- activeScene : Scene&lt;br/&gt;&lt;hr/&gt;+ createScene()&lt;br/&gt;+ loadScene()&lt;br/&gt;+ saveScene()&lt;br/&gt;+ addObject()&lt;br/&gt;+ removeObject()\&quot;]\n\nAM[\&quot;&lt;b&gt;AssetManager&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- assets : List&amp;lt;Asset&amp;gt;&lt;br/&gt;&lt;hr/&gt;+ importAsset()&lt;br/&gt;+ validateAsset()&lt;br/&gt;+ removeAsset()&lt;br/&gt;+ findAsset()\&quot;]\n\nR[\&quot;&lt;b&gt;Renderer&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- activeCamera : Camera&lt;br/&gt;- lightingSystem : LightingSystem&lt;br/&gt;&lt;hr/&gt;+ initialize()&lt;br/&gt;+ renderScene()&lt;br/&gt;+ renderGeometry()&lt;br/&gt;+ applyMaterials()\&quot;]\n\nPE[\&quot;&lt;b&gt;PhysicsEngine&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- gravity : Vector3&lt;br/&gt;&lt;hr/&gt;+ initialize()&lt;br/&gt;+ simulate()&lt;br/&gt;+ detectCollisions()&lt;br/&gt;+ resolveCollisions()\&quot;]\n\nIM[\&quot;&lt;b&gt;InputManager&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- inputMappings : Map&lt;br/&gt;&lt;hr/&gt;+ processInput()&lt;br/&gt;+ mapAction()&lt;br/&gt;+ getActionState()\&quot;]\n\nGR[\&quot;&lt;b&gt;GameRuntime&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- running : bool&lt;br/&gt;- deltaTime : float&lt;br/&gt;&lt;hr/&gt;+ start()&lt;br/&gt;+ update()&lt;br/&gt;+ gameLoop()&lt;br/&gt;+ shutdown()\&quot;]\n\nPR[\&quot;&lt;b&gt;Profiler&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- metrics : List&amp;lt;Metric&amp;gt;&lt;br/&gt;&lt;hr/&gt;+ startFrame()&lt;br/&gt;+ endFrame()&lt;br/&gt;+ measureCPU()&lt;br/&gt;+ measureGPU()&lt;br/&gt;+ generateReport()\&quot;]\n\nBS[\&quot;&lt;b&gt;BuildSystem&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- targetPlatform : String&lt;br/&gt;- buildPath : String&lt;br/&gt;&lt;hr/&gt;+ configureBuild()&lt;br/&gt;+ collectAssets()&lt;br/&gt;+ compile()&lt;br/&gt;+ packageAssets()&lt;br/&gt;+ deploy()\&quot;]\n\n%% =========================================================\n%% SCENE\n%% =========================================================\n\nS[\&quot;&lt;b&gt;Scene&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- id : String&lt;br/&gt;- name : String&lt;br/&gt;- objects : List&amp;lt;GameObject&amp;gt;&lt;br/&gt;&lt;hr/&gt;+ addObject()&lt;br/&gt;+ removeObject()&lt;br/&gt;+ save()&lt;br/&gt;+ load()\&quot;]\n\nGO[\&quot;&lt;b&gt;GameObject&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- id : String&lt;br/&gt;- transform : Transform&lt;br/&gt;- mesh : Mesh&lt;br/&gt;- material : Material&lt;br/&gt;- collider : Collider&lt;br/&gt;&lt;hr/&gt;+ setPosition()&lt;br/&gt;+ setRotation()&lt;br/&gt;+ setScale()\&quot;]\n\nTR[\&quot;&lt;b&gt;Transform&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- position : Vector3&lt;br/&gt;- rotation : Vector3&lt;br/&gt;- scale : Vector3&lt;br/&gt;&lt;hr/&gt;+ translate()&lt;br/&gt;+ rotate()&lt;br/&gt;+ scale()\&quot;]\n\n%% =========================================================\n%% ASSETS\n%% =========================================================\n\nAS[\&quot;&lt;b&gt;Asset&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- id : String&lt;br/&gt;- name : String&lt;br/&gt;- filePath : String&lt;br/&gt;&lt;hr/&gt;+ load()&lt;br/&gt;+ unload()\&quot;]\n\nME[\&quot;&lt;b&gt;Mesh&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- vertices : Vector3&lt;br/&gt;- indices : int&lt;br/&gt;&lt;hr/&gt;+ load()&lt;br/&gt;+ unload()\&quot;]\n\nTX[\&quot;&lt;b&gt;Texture&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- filePath : String&lt;br/&gt;- width : int&lt;br/&gt;- height : int&lt;br/&gt;&lt;hr/&gt;+ load()&lt;br/&gt;+ unload()\&quot;]\n\nMA[\&quot;&lt;b&gt;Material&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- baseColor : Vector3&lt;br/&gt;- metallic : float&lt;br/&gt;- roughness : float&lt;br/&gt;&lt;hr/&gt;+ setColor()&lt;br/&gt;+ setMetallic()&lt;br/&gt;+ setRoughness()\&quot;]\n\n%% =========================================================\n%% RENDERING\n%% =========================================================\n\nCAM[\&quot;&lt;b&gt;Camera&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- position : Vector3&lt;br/&gt;- rotation : Vector3&lt;br/&gt;- fieldOfView : float&lt;br/&gt;&lt;hr/&gt;+ setPosition()&lt;br/&gt;+ setRotation()&lt;br/&gt;+ activate()\&quot;]\n\nLS[\&quot;&lt;b&gt;LightingSystem&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- lights : List&amp;lt;Light&amp;gt;&lt;br/&gt;&lt;hr/&gt;+ addLight()&lt;br/&gt;+ removeLight()&lt;br/&gt;+ configureLight()\&quot;]\n\nLI[\&quot;&lt;b&gt;Light&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- position : Vector3&lt;br/&gt;- color : Vector3&lt;br/&gt;- intensity : float&lt;br/&gt;&lt;hr/&gt;+ setIntensity()&lt;br/&gt;+ setColor()\&quot;]\n\nDL[\&quot;&lt;b&gt;DirectionalLight&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;+ setDirection()\&quot;]\n\nPL[\&quot;&lt;b&gt;PointLight&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- range : float&lt;br/&gt;&lt;hr/&gt;+ setRange()\&quot;]\n\nSL[\&quot;&lt;b&gt;SpotLight&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- angle : float&lt;br/&gt;- range : float&lt;br/&gt;&lt;hr/&gt;+ setAngle()&lt;br/&gt;+ setRange()\&quot;]\n\n%% =========================================================\n%% PHYSICS\n%% =========================================================\n\nCO[\&quot;&lt;b&gt;Collider&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;+ checkCollision()\&quot;]\n\nBC[\&quot;&lt;b&gt;BoxCollider&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- size : Vector3\&quot;]\n\nSC[\&quot;&lt;b&gt;SphereCollider&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- radius : float\&quot;]\n\nMC[\&quot;&lt;b&gt;MeshCollider&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- mesh : Mesh\&quot;]\n\nRB[\&quot;&lt;b&gt;RigidBody&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- mass : float&lt;br/&gt;- velocity : Vector3&lt;br/&gt;&lt;hr/&gt;+ applyForce()&lt;br/&gt;+ applyImpulse()\&quot;]\n\n%% =========================================================\n%% INPUT\n%% =========================================================\n\nAC[\&quot;&lt;b&gt;Action&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- name : String&lt;br/&gt;- type : ActionType&lt;br/&gt;&lt;hr/&gt;+ isPressed()&lt;br/&gt;+ getValue()\&quot;]\n\n%% =========================================================\n%% RUNTIME / PROFILING / BUILD\n%% =========================================================\n\nRS[\&quot;&lt;b&gt;RuntimeState&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- isRunning : Boolean&lt;br/&gt;- isPaused : Boolean&lt;br/&gt;- currentTime : float\&quot;]\n\nMET[\&quot;&lt;b&gt;Metric&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- name : String&lt;br/&gt;- value : float&lt;br/&gt;- unit : String\&quot;]\n\nCFG[\&quot;&lt;b&gt;BuildConfig&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;- platform : String&lt;br/&gt;- outputPath : String&lt;br/&gt;- compression : Boolean\&quot;]\n\n%% =========================================================\n%% EPSTEIN ENGINE\n%% DIRECTED ASSOCIATION\n%% =========================================================\n\nEE --&gt; P\nEE --&gt; SM\nEE --&gt; AM\nEE --&gt; R\nEE --&gt; PE\nEE --&gt; IM\nEE --&gt; GR\nEE --&gt; PR\nEE --&gt; BS\n\n%% =========================================================\n%% ASSOCIATION\n%% =========================================================\n\nGO --- ME\nGO --- MA\nGO --- CO\nGO --- RB\n\n%% =========================================================\n%% AGGREGATION - HOLLOW DIAMOND\n%% =========================================================\n\nSM --- AGG1{\&quot;◇\&quot;} --- S\nAM --- AGG2{\&quot;◇\&quot;} --- AS\nLS --- AGG3{\&quot;◇\&quot;} --- LI\nIM --- AGG4{\&quot;◇\&quot;} --- AC\n\n%% =========================================================\n%% COMPOSITION - FILLED DIAMOND\n%% =========================================================\n\nGO --- COMP1{\&quot;◆\&quot;} --- TR\nGR --- COMP2{\&quot;◆\&quot;} --- RS\nPR --- COMP3{\&quot;◆\&quot;} --- MET\n\n%% =========================================================\n%% GENERALIZATION - HOLLOW TRIANGLE\n%% =========================================================\n\nCO --- GEN1{\&quot;▷\&quot;} --- BC\nCO --- GEN2{\&quot;▷\&quot;} --- SC\nCO --- GEN3{\&quot;▷\&quot;} --- MC\n\nLI --- GEN4{\&quot;▷\&quot;} --- DL\nLI --- GEN5{\&quot;▷\&quot;} --- PL\nLI --- GEN6{\&quot;▷\&quot;} --- SL\n\n%% =========================================================\n%% DIRECTED ASSOCIATIONS\n%% =========================================================\n\nSM --&gt; S\nS --&gt; GO\n\nAM --&gt; AS\nAS --&gt; ME\nAS --&gt; TX\nAS --&gt; MA\n\nR --&gt; S\nR --&gt; CAM\nR --&gt; LS\nR --&gt; MA\nR --&gt; ME\n\nPE --&gt; S\nPE --&gt; CO\nPE --&gt; RB\n\nGR --&gt; RS\nGR --&gt; SM\nGR --&gt; IM\nGR --&gt; PE\nGR --&gt; R\nGR --&gt; PR\n\nPR --&gt; MET\n\nBS --&gt; CFG\nBS --&gt; P\n\n%% =========================================================\n%% DEPENDENCY\n%% =========================================================\n\nR -.-&gt; AM\nPE -.-&gt; ME\nBS -.-&gt; AM\n\n%% =========================================================\n%% USAGE DEPENDENCY\n%% =========================================================\n\nPR -. \&quot;«use»\&quot; .-&gt; R\nPR -. \&quot;«use»\&quot; .-&gt; PE\nGR -. \&quot;«use»\&quot; .-&gt; R\nGR -. \&quot;«use»\&quot; .-&gt; PE\nBS -. \&quot;«use»\&quot; .-&gt; AM\n\n%% =========================================================\n%% UML LEGEND\n%% =========================================================\n\nsubgraph LEGEND[\&quot;UML CLASS DIAGRAM — NOTATION &amp; MEANING\&quot;]\n\nL1[\&quot;Association&lt;br/&gt;────────&lt;br/&gt;Objects of two classes are connected\&quot;]\n\nL2[\&quot;Directed Association&lt;br/&gt;──────────►&lt;br/&gt;Relationship has a specific direction\&quot;]\n\nL3[\&quot;Aggregation&lt;br/&gt;◇────────&lt;br/&gt;Weak whole-part relationship&lt;br/&gt;Part can exist independently\&quot;]\n\nL4[\&quot;Composition&lt;br/&gt;◆────────&lt;br/&gt;Strong whole-part relationship&lt;br/&gt;Part lifecycle belongs to whole\&quot;]\n\nL5[\&quot;Generalization&lt;br/&gt;────────▷&lt;br/&gt;Subclass inherits from superclass&lt;br/&gt;IS-A relationship\&quot;]\n\nL6[\&quot;Realization&lt;br/&gt;- - - -▷&lt;br/&gt;Class implements an interface\&quot;]\n\nL7[\&quot;Dependency&lt;br/&gt;- - - - →&lt;br/&gt;One class depends on another\&quot;]\n\nL8[\&quot;Usage Dependency&lt;br/&gt;- - - - → «use»&lt;br/&gt;One class uses another class service\&quot;]\n\nend\n\n%% =========================================================\n%% COLORS — MAIN CLASSES\n%% =========================================================\n\nstyle EE fill:#17365D,stroke:#5DADE2,color:#FFFFFF,stroke-width:4px\n\nstyle P fill:#D6EAF8,stroke:#2874A6,color:#154360,stroke-width:2px\nstyle SM fill:#D5F5E3,stroke:#239B56,color:#145A32,stroke-width:2px\nstyle AM fill:#FCF3CF,stroke:#B7950B,color:#7D6608,stroke-width:2px\nstyle R fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\nstyle PE fill:#FDEBD0,stroke:#CA6F1E,color:#784212,stroke-width:2px\nstyle IM fill:#FADBD8,stroke:#C0392B,color:#78281F,stroke-width:2px\nstyle GR fill:#D6EAF8,stroke:#3498DB,color:#154360,stroke-width:2px\nstyle PR fill:#D1F2EB,stroke:#148F77,color:#0B5345,stroke-width:2px\nstyle BS fill:#E5E7E9,stroke:#566573,color:#273746,stroke-width:2px\n\n%% SCENE COLORS\nstyle S fill:#D5F5E3,stroke:#239B56,color:#145A32,stroke-width:2px\nstyle GO fill:#D5F5E3,stroke:#239B56,color:#145A32,stroke-width:2px\nstyle TR fill:#D5F5E3,stroke:#239B56,color:#145A32,stroke-width:2px\n\n%% ASSET COLORS\nstyle AS fill:#FCF3CF,stroke:#B7950B,color:#7D6608,stroke-width:2px\nstyle ME fill:#FCF3CF,stroke:#B7950B,color:#7D6608,stroke-width:2px\nstyle TX fill:#FCF3CF,stroke:#B7950B,color:#7D6608,stroke-width:2px\nstyle MA fill:#FCF3CF,stroke:#B7950B,color:#7D6608,stroke-width:2px\n\n%% RENDERING COLORS\nstyle CAM fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\nstyle LS fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\nstyle LI fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\nstyle DL fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\nstyle PL fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\nstyle SL fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\n\n%% PHYSICS COLORS\nstyle CO fill:#FDEBD0,stroke:#CA6F1E,color:#784212,stroke-width:2px\nstyle BC fill:#FDEBD0,stroke:#CA6F1E,color:#784212,stroke-width:2px\nstyle SC fill:#FDEBD0,stroke:#CA6F1E,color:#784212,stroke-width:2px\nstyle MC fill:#FDEBD0,stroke:#CA6F1E,color:#784212,stroke-width:2px\nstyle RB fill:#FDEBD0,stroke:#CA6F1E,color:#784212,stroke-width:2px\n\n%% INPUT\nstyle AC fill:#FADBD8,stroke:#C0392B,color:#78281F,stroke-width:2px\n\n%% RUNTIME / BUILD\nstyle RS fill:#D6EAF8,stroke:#3498DB,color:#154360,stroke-width:2px\nstyle MET fill:#D1F2EB,stroke:#148F77,color:#0B5345,stroke-width:2px\nstyle CFG fill:#E5E7E9,stroke:#566573,color:#273746,stroke-width:2px\n\n%% RELATIONSHIP SYMBOLS\nstyle AGG1 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\nstyle AGG2 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\nstyle AGG3 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\nstyle AGG4 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\n\nstyle COMP1 fill:#333333,stroke:#333333,color:#FFFFFF,stroke-width:2px\nstyle COMP2 fill:#333333,stroke:#333333,color:#FFFFFF,stroke-width:2px\nstyle COMP3 fill:#333333,stroke:#333333,color:#FFFFFF,stroke-width:2px\n\nstyle GEN1 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\nstyle GEN2 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\nstyle GEN3 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\nstyle GEN4 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\nstyle GEN5 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\nstyle GEN6 fill:#FFFFFF,stroke:#333333,color:#000000,stroke-width:2px\n\n%% LEGEND\nstyle LEGEND fill:#FFF8DC,stroke:#B7950B,color:#333333,stroke-width:3px\nstyle L1 fill:#D6EAF8,stroke:#2874A6,color:#154360,stroke-width:2px\nstyle L2 fill:#D5F5E3,stroke:#239B56,color:#145A32,stroke-width:2px\nstyle L3 fill:#FCF3CF,stroke:#B7950B,color:#7D6608,stroke-width:2px\nstyle L4 fill:#FADBD8,stroke:#C0392B,color:#78281F,stroke-width:2px\nstyle L5 fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\nstyle L6 fill:#D1F2EB,stroke:#148F77,color:#0B5345,stroke-width:2px\nstyle L7 fill:#E5E7E9,stroke:#566573,color:#273746,stroke-width:2px\nstyle L8 fill:#D6EAF8,stroke:#3498DB,color:#154360,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vnEgjqSYXmxVSSmhWQC2-805">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
