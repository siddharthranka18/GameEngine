        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: base\n  look: classic\n  themeVariables:\n    primaryColor: \&quot;#E3F2FD\&quot;\n    primaryTextColor: \&quot;#0D47A1\&quot;\n    primaryBorderColor: \&quot;#1565C0\&quot;\n    lineColor: \&quot;#455A64\&quot;\n    actorBkg: \&quot;#E3F2FD\&quot;\n    actorBorder: \&quot;#1565C0\&quot;\n    actorTextColor: \&quot;#0D47A1\&quot;\n    actorLineColor: \&quot;#607D8B\&quot;\n    signalColor: \&quot;#263238\&quot;\n    signalTextColor: \&quot;#263238\&quot;\n    activationBkgColor: \&quot;#BBDEFB\&quot;\n    activationBorderColor: \&quot;#1976D2\&quot;\n    labelBoxBkgColor: \&quot;#FFF3E0\&quot;\n    labelBoxBorderColor: \&quot;#EF6C00\&quot;\n    labelTextColor: \&quot;#E65100\&quot;\n  themeCSS: |\n    .actor-line {\n      stroke: #607D8B !important;\n      stroke-width: 1.5px !important;\n      stroke-dasharray: 6 6 !important;\n    }\n    .actor {\n      fill: #E3F2FD !important;\n      stroke: #1565C0 !important;\n      stroke-width: 2px !important;\n    }\n    .messageLine0 {\n      stroke: #263238 !important;\n      stroke-width: 1.5px !important;\n    }\n    .messageLine1 {\n      stroke: #546E7A !important;\n      stroke-width: 1.5px !important;\n      stroke-dasharray: 5 5 !important;\n    }\n    .activation0,\n    .activation1,\n    .activation2 {\n      fill: #BBDEFB !important;\n      stroke: #1976D2 !important;\n    }\n    .note {\n      fill: #FFF8E1 !important;\n      stroke: #FFB300 !important;\n    }\n---\n\nsequenceDiagram\n\n    actor Developer as Game Developer\n\n    box rgb(227,242,253) PROJECT MANAGEMENT\n        participant Editor as Epstein Editor\n        participant Project as Project Manager\n        participant DB as Project Database\n    end\n\n    box rgb(232,245,233) SCENE &amp; ASSETS\n        participant Scene as Scene Manager\n        participant Asset as Asset Manager\n        participant Material as Material System\n    end\n\n    box rgb(255,243,224) ENGINE SYSTEMS\n        participant Physics as Physics Engine\n        participant Renderer as Rendering Engine\n        participant Audio as Audio System\n        participant Input as Input Manager\n    end\n\n    box rgb(243,229,245) RUNTIME &amp; ANALYSIS\n        participant Runtime as Game Runtime\n        participant Profiler as Profiler\n        participant Build as Build System\n    end\n\n\n    %% ==============================\n    %% PROJECT CREATION\n    %% ==============================\n\n    rect rgb(232,245,253)\n\n        Developer-&gt;&gt;+Editor: Create New Project\n        Editor-&gt;&gt;+Project: createProject(name, path)\n\n        Project-&gt;&gt;+DB: Create Project Record\n        DB--&gt;&gt;-Project: Project Created\n\n        Project--&gt;&gt;-Editor: Project Initialized\n        Editor--&gt;&gt;-Developer: Project Ready\n\n    end\n\n\n    %% ==============================\n    %% SCENE CREATION\n    %% ==============================\n\n    rect rgb(232,245,233)\n\n        Developer-&gt;&gt;+Editor: Create Scene\n        Editor-&gt;&gt;+Scene: createScene()\n\n        Scene-&gt;&gt;Scene: Initialize Scene Data\n        Scene-&gt;&gt;+DB: Save Scene Metadata\n        DB--&gt;&gt;-Scene: Scene Saved\n\n        Scene--&gt;&gt;-Editor: Scene Created\n        Editor--&gt;&gt;-Developer: Display Empty Scene\n\n    end\n\n\n    %% ==============================\n    %% ASSET IMPORT\n    %% ==============================\n\n    rect rgb(255,243,224)\n\n        Developer-&gt;&gt;+Editor: Import 3D Asset\n        Editor-&gt;&gt;+Asset: importAsset(file)\n\n        Asset-&gt;&gt;Asset: Validate Asset\n        Asset-&gt;&gt;Asset: Read Mesh Data\n        Asset-&gt;&gt;Asset: Generate Collision Data\n\n        Asset-&gt;&gt;+DB: Store Asset Metadata\n        DB--&gt;&gt;-Asset: Metadata Stored\n\n        Asset--&gt;&gt;-Editor: Asset Imported\n        Editor--&gt;&gt;-Developer: Show Asset in Browser\n\n    end\n\n\n    %% ==============================\n    %% MATERIAL SETUP\n    %% ==============================\n\n    rect rgb(255,248,225)\n\n        Developer-&gt;&gt;+Editor: Create Material\n        Editor-&gt;&gt;+Material: createMaterial()\n\n        Material-&gt;&gt;Material: Set Base Color\n        Material-&gt;&gt;Material: Set Metallic\n        Material-&gt;&gt;Material: Set Roughness\n\n        Material-&gt;&gt;+DB: Save Material\n        DB--&gt;&gt;-Material: Material Saved\n\n        Material--&gt;&gt;-Editor: Material Ready\n        Editor--&gt;&gt;-Developer: Display Material\n\n    end\n\n\n    %% ==============================\n    %% OBJECT PLACEMENT\n    %% ==============================\n\n    rect rgb(232,245,233)\n\n        Developer-&gt;&gt;+Editor: Place Asset in Scene\n        Editor-&gt;&gt;+Scene: addObject(asset)\n\n        Scene-&gt;&gt;Scene: Create GameObject\n        Scene-&gt;&gt;Scene: Set Transform\n        Scene-&gt;&gt;+Material: Apply Material\n        Material--&gt;&gt;-Scene: Material Applied\n\n        Scene--&gt;&gt;-Editor: Object Added\n        Editor--&gt;&gt;-Developer: Display Object\n\n    end\n\n\n    %% ==============================\n    %% GAME EXECUTION\n    %% ==============================\n\n    rect rgb(243,229,245)\n\n        Developer-&gt;&gt;+Editor: Run Game\n        Editor-&gt;&gt;+Runtime: start()\n\n        Runtime-&gt;&gt;+Scene: loadActiveScene()\n        Scene--&gt;&gt;-Runtime: Scene Loaded\n\n        Runtime-&gt;&gt;+Input: initialize()\n        Input--&gt;&gt;-Runtime: Input Ready\n\n        Runtime-&gt;&gt;+Physics: initialize()\n        Physics--&gt;&gt;-Runtime: Physics Ready\n\n        Runtime-&gt;&gt;+Renderer: initialize()\n        Renderer--&gt;&gt;-Runtime: Renderer Ready\n\n        Runtime-&gt;&gt;+Audio: initialize()\n        Audio--&gt;&gt;-Runtime: Audio Ready\n\n    end\n\n\n    %% ==============================\n    %% MAIN GAME LOOP\n    %% ==============================\n\n    rect rgb(237,247,250)\n\n        loop Every Frame\n\n            Runtime-&gt;&gt;+Input: processInput()\n            Input--&gt;&gt;-Runtime: Input State\n\n            Runtime-&gt;&gt;+Physics: simulate(deltaTime)\n\n            Physics-&gt;&gt;Physics: Apply Forces\n            Physics-&gt;&gt;Physics: Detect Collisions\n            Physics-&gt;&gt;Physics: Resolve Collisions\n\n            Physics--&gt;&gt;-Runtime: Updated Physics State\n\n            Runtime-&gt;&gt;+Scene: update(deltaTime)\n            Scene-&gt;&gt;Scene: Update GameObjects\n            Scene--&gt;&gt;-Runtime: Scene Updated\n\n            Runtime-&gt;&gt;+Audio: update()\n            Audio--&gt;&gt;-Runtime: Audio State Updated\n\n            Runtime-&gt;&gt;+Renderer: renderScene(Scene)\n\n            Renderer-&gt;&gt;Renderer: Process Geometry\n            Renderer-&gt;&gt;Renderer: Apply Materials\n            Renderer-&gt;&gt;Renderer: Calculate Lighting\n            Renderer-&gt;&gt;Renderer: Render Shadows\n            Renderer-&gt;&gt;Renderer: Render Frame\n\n            Renderer--&gt;&gt;-Runtime: Frame Rendered\n\n            Runtime-&gt;&gt;+Profiler: recordFrame()\n            Profiler-&gt;&gt;Profiler: Measure CPU\n            Profiler-&gt;&gt;Profiler: Measure GPU\n            Profiler-&gt;&gt;Profiler: Measure Memory\n            Profiler--&gt;&gt;-Runtime: Performance Metrics\n\n        end\n\n    end\n\n\n    %% ==============================\n    %% DEBUGGING\n    %% ==============================\n\n    rect rgb(255,235,238)\n\n        opt Developer Enables Debugging\n\n            Developer-&gt;&gt;Editor: Open Debugger\n            Editor-&gt;&gt;+Runtime: Enable Debug Mode\n\n            Runtime-&gt;&gt;+Profiler: Start Profiling\n            Profiler--&gt;&gt;-Runtime: Profiling Active\n\n            Runtime--&gt;&gt;-Editor: Debug Information\n            Editor--&gt;&gt;Developer: Display Debug Data\n\n        end\n\n    end\n\n\n    %% ==============================\n    %% STOP GAME\n    %% ==============================\n\n    rect rgb(255,243,224)\n\n        Developer-&gt;&gt;+Editor: Stop Game\n        Editor-&gt;&gt;+Runtime: stop()\n\n        Runtime-&gt;&gt;+Physics: shutdown()\n        Physics--&gt;&gt;-Runtime: Physics Stopped\n\n        Runtime-&gt;&gt;+Audio: shutdown()\n        Audio--&gt;&gt;-Runtime: Audio Stopped\n\n        Runtime-&gt;&gt;+Renderer: shutdown()\n        Renderer--&gt;&gt;-Runtime: Renderer Stopped\n\n        Runtime-&gt;&gt;+Input: shutdown()\n        Input--&gt;&gt;-Runtime: Input Stopped\n\n        Runtime--&gt;&gt;-Editor: Runtime Stopped\n        Editor--&gt;&gt;-Developer: Return to Editor\n\n    end\n\n\n    %% ==============================\n    %% BUILD\n    %% ==============================\n\n    rect rgb(232,240,254)\n\n        Developer-&gt;&gt;+Editor: Build Game\n        Editor-&gt;&gt;+Build: configureBuild()\n\n        Build-&gt;&gt;Build: Set Target Platform\n        Build-&gt;&gt;+Asset: collectAssets()\n        Asset--&gt;&gt;-Build: Assets Collected\n\n        Build-&gt;&gt;Build: Compile Game\n        Build-&gt;&gt;Build: Package Assets\n        Build-&gt;&gt;+DB: Read Project Configuration\n        DB--&gt;&gt;-Build: Configuration\n\n        Build--&gt;&gt;-Editor: Build Completed\n        Editor--&gt;&gt;-Developer: Executable Generated\n\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zokSJFCoZ2j6a4sjj5KP-346">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
