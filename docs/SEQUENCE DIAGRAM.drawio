  <diagram name="Page-1" id="dpZBIlZHQufuA18Lskic">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\n    actor Developer as Game Developer\n\n    participant UI as Epstein Editor\n    participant Project as Project Manager\n    participant Scene as Scene Manager\n    participant Asset as Asset Manager\n    participant DB as Project Database\n    participant Physics as Physics Engine\n    participant Renderer as Rendering Engine\n    participant Runtime as Game Runtime\n    participant Profiler as Profiler\n\n    %% ========================================\n    %% PROJECT CREATION / OPENING\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Create / Open Project\n\n    UI-&gt;&gt;Project: createOrOpenProject()\n    Project-&gt;&gt;DB: loadProjectData()\n    DB--&gt;&gt;Project: Project Data\n    Project--&gt;&gt;UI: Project Loaded\n    UI--&gt;&gt;Developer: Display Project\n\n\n    %% ========================================\n    %% SCENE MANAGEMENT\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Open Scene\n\n    UI-&gt;&gt;Scene: loadScene(sceneId)\n    Scene-&gt;&gt;DB: readSceneData(sceneId)\n    DB--&gt;&gt;Scene: Scene Objects and Properties\n    Scene--&gt;&gt;UI: Scene Loaded\n    UI--&gt;&gt;Developer: Display Scene\n\n\n    %% ========================================\n    %% ASSET IMPORT\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Import 3D Asset\n\n    UI-&gt;&gt;Asset: importAsset(file)\n\n    Asset-&gt;&gt;Asset: validateGeometry()\n    Asset-&gt;&gt;Asset: validateTextures()\n    Asset-&gt;&gt;Asset: generateCollisionData()\n    Asset-&gt;&gt;Asset: generateLOD()\n\n    Asset-&gt;&gt;DB: saveAsset(asset)\n    DB--&gt;&gt;Asset: Asset ID / Storage Reference\n\n    Asset--&gt;&gt;UI: Asset Imported\n    UI--&gt;&gt;Developer: Display Asset\n\n\n    %% ========================================\n    %% OBJECT PLACEMENT\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Place Asset in Scene\n\n    UI-&gt;&gt;Scene: addObject(assetId, transform)\n\n    Scene-&gt;&gt;Asset: getAsset(assetId)\n    Asset--&gt;&gt;Scene: Asset Data\n\n    Scene-&gt;&gt;Scene: setPosition()\n    Scene-&gt;&gt;Scene: setRotation()\n    Scene-&gt;&gt;Scene: setScale()\n    Scene-&gt;&gt;Scene: updateSceneHierarchy()\n\n    Scene-&gt;&gt;DB: saveSceneChanges()\n    DB--&gt;&gt;Scene: Scene Saved\n\n    Scene--&gt;&gt;UI: Object Placed\n    UI--&gt;&gt;Developer: Display Updated Scene\n\n\n    %% ========================================\n    %% LIGHTING CONFIGURATION\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Configure Lighting\n\n    UI-&gt;&gt;Scene: updateLighting(parameters)\n    Scene-&gt;&gt;DB: saveLightingData()\n    DB--&gt;&gt;Scene: Lighting Saved\n\n    Scene--&gt;&gt;UI: Lighting Updated\n\n\n    %% ========================================\n    %% CAMERA CONFIGURATION\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Configure Camera\n\n    UI-&gt;&gt;Scene: updateCamera(parameters)\n    Scene-&gt;&gt;DB: saveCameraData()\n    DB--&gt;&gt;Scene: Camera Saved\n\n    Scene--&gt;&gt;UI: Camera Updated\n\n\n    %% ========================================\n    %% RUN GAME\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Run / Preview Game\n\n    UI-&gt;&gt;Runtime: start(sceneId)\n\n    Runtime-&gt;&gt;Scene: loadRuntimeScene()\n    Scene--&gt;&gt;Runtime: Runtime Scene\n\n\n    %% ========================================\n    %% GAME LOOP\n    %% ========================================\n\n    loop Game Loop\n\n        Runtime-&gt;&gt;Physics: simulate(deltaTime)\n\n        Physics-&gt;&gt;Physics: applyForces()\n        Physics-&gt;&gt;Physics: detectCollisions()\n        Physics-&gt;&gt;Physics: resolveCollisions()\n\n        Physics--&gt;&gt;Runtime: Updated Physics State\n\n        Runtime-&gt;&gt;Profiler: startFrame()\n\n        Runtime-&gt;&gt;Renderer: renderScene(scene)\n\n        Renderer-&gt;&gt;Scene: getVisibleObjects()\n        Scene--&gt;&gt;Renderer: Visible Scene Objects\n\n        Renderer-&gt;&gt;Asset: getRequiredAssetData()\n        Asset--&gt;&gt;Renderer: Meshes / Textures / Materials\n\n        Renderer-&gt;&gt;Renderer: processGeometry()\n        Renderer-&gt;&gt;Renderer: applyMaterials()\n        Renderer-&gt;&gt;Renderer: calculateLighting()\n        Renderer-&gt;&gt;Renderer: renderShadows()\n        Renderer-&gt;&gt;Renderer: renderFrame()\n\n        Renderer--&gt;&gt;UI: Rendered Frame\n        UI--&gt;&gt;Developer: Display Game Frame\n\n        Runtime-&gt;&gt;Profiler: endFrame()\n        Profiler--&gt;&gt;Runtime: FPS / CPU / GPU / Memory Metrics\n\n    end\n\n\n    %% ========================================\n    %% STOP GAME\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Stop Game\n\n    UI-&gt;&gt;Runtime: stop()\n    Runtime--&gt;&gt;UI: Game Stopped\n\n    UI--&gt;&gt;Developer: Return to Editor\n\n\n    %% ========================================\n    %% SAVE PROJECT\n    %% ========================================\n\n    Developer-&gt;&gt;UI: Save Project\n\n    UI-&gt;&gt;Project: saveProject()\n\n    Project-&gt;&gt;Scene: saveScene()\n    Scene-&gt;&gt;DB: persistSceneData()\n    DB--&gt;&gt;Scene: Scene Saved\n\n    Project-&gt;&gt;DB: persistProjectData()\n    DB--&gt;&gt;Project: Project Saved\n\n    Project--&gt;&gt;UI: Save Successful\n    UI--&gt;&gt;Developer: Save Confirmation&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QpohD5Kj3deNe1srcHhx-1">
