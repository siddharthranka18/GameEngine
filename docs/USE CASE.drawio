        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% ========================================\n    %% ACTORS\n    %% ========================================\n\n    Developer([\&quot;👤 Game Developer\&quot;])\n    Artist([\&quot;🎨 Technical Artist\&quot;])\n    Tester([\&quot;🧪 Tester / Debugger\&quot;])\n    Release([\&quot;🚀 Build / Release User\&quot;])\n\n    %% ========================================\n    %% SYSTEM BOUNDARY\n    %% ========================================\n\n    subgraph ENGINE[\&quot;EPSTEIN ENGINE\&quot;]\n\n        %% Project\n        UC1((\&quot;Create Project\&quot;))\n        UC2((\&quot;Open Project\&quot;))\n        UC3((\&quot;Save Project\&quot;))\n        UC4((\&quot;Configure Project\&quot;))\n\n        %% Scene\n        UC5((\&quot;Create / Manage Scene\&quot;))\n        UC6((\&quot;Place &amp; Transform Object\&quot;))\n        UC7((\&quot;Manage Object Hierarchy\&quot;))\n\n        %% Assets\n        UC8((\&quot;Import 3D Asset\&quot;))\n        UC9((\&quot;Validate Asset\&quot;))\n        UC10((\&quot;Manage Asset Library\&quot;))\n\n        %% Materials\n        UC11((\&quot;Create Material\&quot;))\n        UC12((\&quot;Edit Material\&quot;))\n        UC13((\&quot;Manage Textures\&quot;))\n\n        %% Rendering / Environment\n        UC14((\&quot;Configure Lighting\&quot;))\n        UC15((\&quot;Configure Camera\&quot;))\n        UC16((\&quot;Configure Rendering\&quot;))\n\n        %% Physics\n        UC17((\&quot;Configure Physics\&quot;))\n        UC18((\&quot;Manage Collisions\&quot;))\n\n        %% Runtime\n        UC19((\&quot;Run / Preview Game\&quot;))\n        UC20((\&quot;Manage Input\&quot;))\n        UC21((\&quot;Manage Audio\&quot;))\n\n        %% Testing / Debugging\n        UC22((\&quot;Debug Game\&quot;))\n        UC23((\&quot;Profile Game\&quot;))\n        UC24((\&quot;View Performance Metrics\&quot;))\n\n        %% Build\n        UC25((\&quot;Configure Build\&quot;))\n        UC26((\&quot;Build Game\&quot;))\n        UC27((\&quot;Package Assets\&quot;))\n        UC28((\&quot;Deploy Game\&quot;))\n\n    end\n\n\n    %% ========================================\n    %% GAME DEVELOPER\n    %% ========================================\n\n    Developer --- UC1\n    Developer --- UC2\n    Developer --- UC3\n    Developer --- UC4\n\n    Developer --- UC5\n    Developer --- UC6\n    Developer --- UC7\n\n    Developer --- UC8\n    Developer --- UC10\n\n    Developer --- UC11\n    Developer --- UC12\n    Developer --- UC13\n\n    Developer --- UC14\n    Developer --- UC15\n    Developer --- UC16\n\n    Developer --- UC17\n    Developer --- UC18\n\n    Developer --- UC19\n    Developer --- UC20\n    Developer --- UC21\n\n\n    %% ========================================\n    %% TECHNICAL ARTIST\n    %% ========================================\n\n    Artist --- UC8\n    Artist --- UC9\n    Artist --- UC10\n\n    Artist --- UC11\n    Artist --- UC12\n    Artist --- UC13\n\n    Artist --- UC14\n    Artist --- UC15\n    Artist --- UC16\n\n\n    %% ========================================\n    %% TESTER / DEBUGGER\n    %% ========================================\n\n    Tester --- UC2\n    Tester --- UC19\n    Tester --- UC20\n    Tester --- UC21\n\n    Tester --- UC22\n    Tester --- UC23\n    Tester --- UC24\n\n\n    %% ========================================\n    %% BUILD / RELEASE USER\n    %% ========================================\n\n    Release --- UC2\n    Release --- UC3\n    Release --- UC25\n    Release --- UC26\n    Release --- UC27\n    Release --- UC28\n\n\n    %% ========================================\n    %% INCLUDE RELATIONSHIPS\n    %% ========================================\n\n    UC8 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC9\n\n    UC5 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC6\n\n    UC11 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC13\n\n    UC19 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC5\n    UC19 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC15\n    UC19 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC16\n    UC19 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC17\n    UC19 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC20\n    UC19 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC21\n\n    UC26 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC25\n    UC26 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC27\n\n\n    %% ========================================\n    %% EXTEND RELATIONSHIPS\n    %% ========================================\n\n    UC22 -. \&quot;&lt;&lt;extend&gt;&gt;\&quot; .-&gt; UC19\n    UC23 -. \&quot;&lt;&lt;extend&gt;&gt;\&quot; .-&gt; UC19\n    UC24 -. \&quot;&lt;&lt;extend&gt;&gt;\&quot; .-&gt; UC23\n\n    UC28 -. \&quot;&lt;&lt;extend&gt;&gt;\&quot; .-&gt; UC26&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nJw5rYY7fhEkdy8tvCpN-62">
