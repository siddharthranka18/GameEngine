        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% ==============================\n    %% ACTORS\n    %% ==============================\n\n    GD([\&quot;🧍 Game Developer\&quot;])\n    TA([\&quot;🧍 Technical Artist\&quot;])\n    TD([\&quot;🧍 Tester / Debugger\&quot;])\n    BR([\&quot;🧍 Build / Release User\&quot;])\n\n\n    %% ==============================\n    %% SYSTEM BOUNDARY\n    %% ==============================\n\n    subgraph ENGINE[\&quot;EPSTEIN ENGINE\&quot;]\n        direction TB\n\n        %% PROJECT\n        UC1((\&quot;Create Project\&quot;))\n        UC2((\&quot;Open Project\&quot;))\n        UC3((\&quot;Save Project\&quot;))\n        UC4((\&quot;Configure Project\&quot;))\n\n        %% SCENE\n        UC5((\&quot;Create / Manage Scene\&quot;))\n        UC6((\&quot;Place &amp; Transform Object\&quot;))\n        UC7((\&quot;Manage Object Hierarchy\&quot;))\n\n        %% ASSETS\n        UC8((\&quot;Import 3D Asset\&quot;))\n        UC9((\&quot;Validate Asset\&quot;))\n        UC10((\&quot;Manage Asset Library\&quot;))\n\n        %% MATERIALS\n        UC11((\&quot;Create Material\&quot;))\n        UC12((\&quot;Edit Material\&quot;))\n        UC13((\&quot;Manage Textures\&quot;))\n\n        %% RENDERING\n        UC14((\&quot;Configure Lighting\&quot;))\n        UC15((\&quot;Configure Camera\&quot;))\n        UC16((\&quot;Configure Rendering\&quot;))\n\n        %% PHYSICS\n        UC17((\&quot;Configure Physics\&quot;))\n        UC18((\&quot;Manage Collisions\&quot;))\n\n        %% RUNTIME\n        UC19((\&quot;Run / Preview Game\&quot;))\n        UC20((\&quot;Manage Input\&quot;))\n        UC21((\&quot;Manage Audio\&quot;))\n\n        %% TESTING\n        UC22((\&quot;Debug Game\&quot;))\n        UC23((\&quot;Profile Game\&quot;))\n        UC24((\&quot;View Performance Metrics\&quot;))\n\n        %% BUILD\n        UC25((\&quot;Configure Build\&quot;))\n        UC26((\&quot;Build Game\&quot;))\n        UC27((\&quot;Package Assets\&quot;))\n        UC28((\&quot;Deploy Game\&quot;))\n\n\n        %% ==============================\n        %% INCLUDE\n        %% ==============================\n\n        UC8 -. \&quot;«include»\&quot; .-&gt; UC9\n\n        UC5 -. \&quot;«include»\&quot; .-&gt; UC6\n\n        UC11 -. \&quot;«include»\&quot; .-&gt; UC13\n\n        UC19 -. \&quot;«include»\&quot; .-&gt; UC5\n        UC19 -. \&quot;«include»\&quot; .-&gt; UC15\n        UC19 -. \&quot;«include»\&quot; .-&gt; UC16\n        UC19 -. \&quot;«include»\&quot; .-&gt; UC17\n        UC19 -. \&quot;«include»\&quot; .-&gt; UC20\n        UC19 -. \&quot;«include»\&quot; .-&gt; UC21\n\n        UC26 -. \&quot;«include»\&quot; .-&gt; UC25\n        UC26 -. \&quot;«include»\&quot; .-&gt; UC27\n\n\n        %% ==============================\n        %% EXTEND\n        %% ==============================\n\n        UC22 -. \&quot;«extend»\&quot; .-&gt; UC19\n\n        UC23 -. \&quot;«extend»\&quot; .-&gt; UC19\n\n        UC24 -. \&quot;«extend»\&quot; .-&gt; UC23\n\n        UC28 -. \&quot;«extend»\&quot; .-&gt; UC26\n\n    end\n\n\n    %% ==============================\n    %% GAME DEVELOPER\n    %% ==============================\n\n    GD --- UC1\n    GD --- UC2\n    GD --- UC3\n    GD --- UC4\n\n    GD --- UC5\n    GD --- UC6\n    GD --- UC7\n\n    GD --- UC8\n    GD --- UC10\n\n    GD --- UC11\n    GD --- UC12\n    GD --- UC13\n\n    GD --- UC14\n    GD --- UC15\n    GD --- UC16\n\n    GD --- UC17\n    GD --- UC18\n\n    GD --- UC19\n    GD --- UC20\n    GD --- UC21\n\n\n    %% ==============================\n    %% TECHNICAL ARTIST\n    %% ==============================\n\n    TA --- UC8\n    TA --- UC9\n    TA --- UC10\n\n    TA --- UC11\n    TA --- UC12\n    TA --- UC13\n\n    TA --- UC14\n    TA --- UC15\n    TA --- UC16\n\n\n    %% ==============================\n    %% TESTER / DEBUGGER\n    %% ==============================\n\n    TD --- UC2\n    TD --- UC19\n    TD --- UC20\n    TD --- UC21\n\n    TD --- UC22\n    TD --- UC23\n    TD --- UC24\n\n\n    %% ==============================\n    %% BUILD / RELEASE USER\n    %% ==============================\n\n    BR --- UC2\n    BR --- UC3\n\n    BR --- UC25\n    BR --- UC26\n    BR --- UC27\n    BR --- UC28\n\n\n    %% ==============================\n    %% COLORS\n    %% ==============================\n\n    classDef actor fill:#D5F5E3,stroke:#239B56,color:#145A32,stroke-width:2px\n\n    classDef project fill:#D6EAF8,stroke:#2874A6,color:#154360,stroke-width:2px\n\n    classDef asset fill:#FCF3CF,stroke:#B7950B,color:#7D6608,stroke-width:2px\n\n    classDef rendering fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\n\n    classDef physics fill:#FDEBD0,stroke:#CA6F1E,color:#784212,stroke-width:2px\n\n    classDef runtime fill:#E8DAEF,stroke:#7D3C98,color:#512E5F,stroke-width:2px\n\n    classDef testing fill:#FADBD8,stroke:#C0392B,color:#78281F,stroke-width:2px\n\n    classDef build fill:#D5DBDB,stroke:#566573,color:#273746,stroke-width:2px\n\n\n    class GD,TA,TD,BR actor\n\n    class UC1,UC2,UC3,UC4,UC5,UC6,UC7 project\n\n    class UC8,UC9,UC10,UC11,UC12,UC13 asset\n\n    class UC14,UC15,UC16 rendering\n\n    class UC17,UC18 physics\n\n    class UC19,UC20,UC21 runtime\n\n    class UC22,UC23,UC24 testing\n\n    class UC25,UC26,UC27,UC28 build\n\n\n    %% ==============================\n    %% SYSTEM BOUNDARY\n    %% ==============================\n\n    style ENGINE fill:#FAFAFA,stroke:#333333,stroke-width:3px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ATpTbnUKG2BYBSeizgua-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
